# Maven build output (recreated on every "mvn test")
target/

# Screenshots are produced by test runs (CI uploads them as an artifact)
screenshots/

# IDE files
.idea/
*.iml
# keep .vscode/tasks.json (the run buttons), ignore other VS Code files
.vscode/*
!.vscode/tasks.json

# manual javac output
out/

# VS Code Java-upgrade tool files
.github/modernize/

# OS junk
.DS_Store
Thumbs.db
