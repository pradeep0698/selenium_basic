<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Topic 14: Cross-browser parallel testing.

  parallel="tests" thread-count="2"   -> the Chrome block and the Edge block run AT THE SAME TIME.
  Each block runs the SAME test classes, in its own browser (= coverage: does the app work everywhere?).
  Inside each block, parallel="methods" thread-count="3" -> 3 windows SPLIT that block's tests (= speed).
  So: up to 3 Chrome + 3 Edge windows at once.

  Run: Ctrl+Shift+P -> "Run Task" -> "Run cross-browser (Chrome + Edge)"
       or: mvnw test -Dsuite=testng-crossbrowser.xml
  Firefox: copy a block, set value="firefox" (needs Firefox installed).
-->
<suite name="Cross Browser" parallel="tests" thread-count="2">

    <test name="Chrome" parallel="methods" thread-count="3">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.T02_ActionsTest"/>
            <class name="tests.T04_DropdownTest"/>
            <class name="tests.T09_PageObjectLoginTest"/>
            <class name="tests.T10_DataDrivenTest"/>
        </classes>
    </test>

    <test name="Edge" parallel="methods" thread-count="3">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="tests.T02_ActionsTest"/>
            <class name="tests.T04_DropdownTest"/>
            <class name="tests.T09_PageObjectLoginTest"/>
            <class name="tests.T10_DataDrivenTest"/>
        </classes>
    </test>

</suite>
