<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- The list of tests TestNG runs. Comment out a class to skip it. -->
<!-- parallel="methods": test methods run at the same time; thread-count = how many browsers at once.
     Safe because each thread has its own browser (DriverFactory uses ThreadLocal).
     Try thread-count="1" to compare the time. -->
<suite name="Selenium Basics" parallel="methods" thread-count="3">
    <test name="All topics">
        <classes>
            <class name="tests.T01_LocatorsTest"/>
            <class name="tests.T02_ActionsTest"/>
            <class name="tests.T03_WaitsTest"/>
            <class name="tests.T04_DropdownTest"/>
            <class name="tests.T05_AlertsTest"/>
            <class name="tests.T06_FramesWindowsTest"/>
            <class name="tests.T07_MouseKeyboardTest"/>
            <class name="tests.T08_ScreenshotTest"/>
            <class name="tests.T09_PageObjectLoginTest"/>
            <class name="tests.T10_DataDrivenTest"/>
            <!-- Fails on purpose (see the class). Comment it out once you have seen the red run. -->
            <class name="tests.T11_FailDemoTest"/>
        </classes>
    </test>
</suite>
